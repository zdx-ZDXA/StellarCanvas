{
  "enable": {
    "type": "bool",
    "description": "启用生图",
    "default": true
  },
  "backend": {
    "type": "string",
    "description": "生图后端",
    "default": "nai",
    "options": [
      "nai",
      "openai"
    ],
    "hint": "nai=NovelAI，openai=OpenAI 兼容接口"
  },
  "api_key": {
    "type": "string",
    "description": "API 密钥",
    "default": ""
